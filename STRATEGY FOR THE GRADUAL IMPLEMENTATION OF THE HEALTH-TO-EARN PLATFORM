async def _check_requirements_met(metrics: RolloutMetrics, requirements: Dict[str, float]) -> bool:
    """Проверка соответствия требованиям"""
    for metric, threshold in requirements.items():
        if metric == 'user_satisfaction' and metrics.user_satisfaction < threshold:
            return False
        elif metric == 'system_uptime' and metrics.system_stability < threshold:
            return False
        elif metric == 'response_time' and metrics.performance_metrics.get('response_time', 0) > threshold:
            return False
        elif metric == 'error_rate' and sum(metrics.error_rates.values()) > threshold:
            return False
    
    return True

