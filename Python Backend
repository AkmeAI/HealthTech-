# Утилиты для оптимизации
class LRUCache:
    """Простая реализация LRU кэша"""
    
    def __init__(self, maxsize: int = 1000):
        self.maxsize = maxsize
        self.cache = {}
        self.order = []
    
    def get(self, key):
        if key in self.cache:
            # Перемещаем в конец (самый недавний)
            self.order.remove(key)
            self.order.append(key)
            return self.cache[key]
        return None
    
    def put(self, key, value):
        if key in self.cache:
            self.order.remove(key)
        elif len(self.cache) >= self.maxsize:
            # Удаляем самый старый
            oldest = self.order.pop(0)
            del self.cache[oldest]
        
        self.cache[key] = value
        self.order.append(key)

class BatchPredictor:
    """Оптимизатор пакетных предсказаний"""
    
    def __init__(self, max_batch_size: int = 100):
        self.max_batch_size = max_batch_size
        self.batch_queue = []
        self.processing = False
    
    async def add_prediction(self, data):
        """Добавление данных в батч"""
        self.batch_queue.append(data)
        
        if len(self.batch_queue) >= self.max_batch_size and not self.processing:
            await self.process_batch()
    
    async def process_batch(self):
        """Обработка полного батча"""
        self.processing = True
        try:
            batch_data = self.batch_queue[:self.max_batch_size]
            self.batch_queue = self.batch_queue[self.max_batch_size:]
            
            # Здесь была бы реальная обработка батча
            await asyncio.sleep(0.001)  # Имитация ML inference
            
        finally:
            self.processing = False
