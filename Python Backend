@app.post("/api/v2/health/batch-process")
@cache(expire=60)  # Кэширование на 60 секунд
async def batch_process_health_data_optimized(
    metrics: List[OptimizedHealthMetric],
    background_tasks: BackgroundTasks
):
    """Оптимизированный endpoint для обработки health данных"""
    start_time = time.perf_counter()
    
    try:
        # Основная обработка
        scores = await health_processor.process_health_batch(metrics)
        
        # Фоновая задача для AI анализа
        background_tasks.add_task(
            ai_agents.batch_predict_optimized,
            {uid: [m for m in metrics if m.user_id == uid] for uid in scores.keys()}
        )
        
        processing_time = time.perf_counter() - start_time
        
        return {
            "status": "success",
            "scores": scores,
            "processing_time": round(processing_time, 4),
            "metrics_processed": len(metrics),
            "cache_hit": False
        }
        
    except Exception as e:
        logger.error(f"Batch processing error: {e}")
        raise HTTPException(status_code=500, detail="Processing failed")

