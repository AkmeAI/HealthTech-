# Экспорт архитектуры в различные форматы
class ArchitectureExporter:
    """Экспортер архитектурной документации"""
    
    @staticmethod
    def export_to_json(architecture_doc: Dict) -> str:
        return json.dumps(architecture_doc, indent=2, default=str)
    
    @staticmethod
    def export_to_markdown(architecture_doc: Dict) -> str:
        md = "# Health-to-Earn Platform - Complete Technical Architecture\n\n"
        
        for section, content in architecture_doc.items():
            md += f"## {section.replace('_', ' ').title()}\n\n"
            if isinstance(content, dict):
                for subsection, subcontent in content.items():
                    md += f"### {subsection.replace('_', ' ').title()}\n\n"
                    md += f"```json\n{json.dumps(subcontent, indent=2, default=str)}\n```\n\n"
            else:
                md += f"{content}\n\n"
        
        return md
    
