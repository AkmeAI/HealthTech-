                logging.StreamHandler()
            ]
        )
    
    async def start_complete_system(self):
        """Запуск полной системы самоулучшения и мониторинга"""
        logger.info("🌐 Starting Complete Self-Improving Monitoring System...")
        
        # Запуск Prometheus метрик сервера
        start_http_server(8000)
        
        # Запуск всех компонентов
        tasks = [
            self.improvement_engine.start_continuous_improvement(),
            self.monitoring_system.start_comprehensive_monitoring(),
            self.health_checker.start_health_checks(),
            self._global_coordination_loop()
        ]
        
        await asyncio.gather(*tasks)
    
    async def _global_coordination_loop(self):
        """Глобальная координация между компонентами"""
        while True:
            try:
                # Координация улучшений и мониторинга
                await self._coordinate_improvements()
                
                # Анализ общей эффективности системы
                await self._analyze_system_effectiveness()
                
                # Генерация отчетов
                await self._generate_reports()
                
                await asyncio.sleep(600)  # Координация каждые 10 минут
                
            except Exception as e:
                logger.error(f"Global coordination error: {e}")
                await asyncio.sleep(60)

class SystemHealthChecker:
    """Проверка здоровья системы"""
    
    async def start_health_checks(self):
        """Запуск проверок здоровья"""
        while True:
            try:
                health_status = await self._check_system_health()
                
                if health_status['overall'] != 'healthy':
                    await self._handle_health_issues(health_status)
                
                await asyncio.sleep(60)  # Проверка каждую минуту
                
            except Exception as e:
                logger.error(f"Health check error: {e}")
                await asyncio.sleep(30)
    
    async def _check_system_health(self) -> Dict[str, Any]:
        """Проверка здоровья всех компонентов системы"""
        health_checks = {
            'api': await self._check_api_health(),
            'database': await self._check_database_health(),
            'cache': await self._check_cache_health(),
            'ai_models': await self._check_ai_models_health()
        }
        
        # Расчет общего здоровья системы
        overall_health = 'healthy'
        if any(check['status'] == 'critical' for check in health_checks.values()):
            overall_health = 'critical'
        elif any(check['status'] == 'degraded' for check in health_checks.values()):
            overall_health = 'degraded'
        
        return {
            'overall': overall_health,
            'components': health_checks,
            'timestamp': datetime.now()
        }

# Утилитарные функции
async def _simulate_improvement(opportunity: ImprovementOpportunity, improvement: float) -> Dict[str, float]:
    """Симуляция улучшения метрик"""
    return {
        opportunity.metric: opportunity.current_value * (1 - improvement),
        'user_satisfaction': min(100, opportunity.current_value + improvement * 10)
    }

def _select_strategy_for_metric(metric: str) -> ImprovementStrategy:
    """Выбор стратегии для метрики"""
    strategy_map = {
        'response_time': ImprovementStrategy.BAYESIAN_OPTIMIZATION,
        'error_rate': ImprovementStrategy.REINFORCEMENT_LEARNING,
        'throughput': ImprovementStrategy.EVOLUTIONARY,
        'cache_hit_rate': ImprovementStrategy.META_LEARNING
    }
    return strategy_map.get(metric, ImprovementStrategy.BAYESIAN_OPTIMIZATION)

async def _identify_bottlenecks(metrics: List[SystemMetrics]) -> List[Dict]:
    """Выявление узких мест в системе"""
    bottlenecks = []
    
    # Анализ последних метрик
    recent = metrics[-10:]
    
    # Проверка высокого response time
    avg_response_time = np.mean([m.response_time for m in recent])
    if avg_response_time > 300:  # ms
        bottlenecks.append({
            'component': ComponentType.API,
            'metric': 'response_time',
            'current_value': avg_response_time,
            'target_value': 150,
            'confidence': 0.8,
            'impact': 0.4,
            'priority': 'high'
        })
    
    # Проверка высокой error rate
    avg_error_rate = np.mean([m.error_rate for m in recent])
    if avg_error_rate > 2.0:  # %
        bottlenecks.append({
            'component': ComponentType.API,
            'metric': 'error_rate', 
            'current_value': avg_error_rate,
            'target_value': 0.5,
            'confidence': 0.9,
            'impact': 0.6,
            'priority': 'critical'
        })
    
    return bottlenecks

def _select_strategy_for_bottleneck(bottleneck: Dict) -> ImprovementStrategy:
    """Выбор стратегии для узкого места"""
    if bottleneck['priority'] == 'critical':
        return ImprovementStrategy.REINFORCEMENT_LEARNING
    elif bottleneck['metric'] == 'response_time':
        return ImprovementStrategy.BAYESIAN_OPTIMIZATION
    else:
        return ImprovementStrategy.EVOLUTIONARY

