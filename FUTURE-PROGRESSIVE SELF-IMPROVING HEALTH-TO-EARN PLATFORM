class FutureTense(Enum):
    """Временные горизонты для прогрессивного улучшения"""
    IMMEDIATE = "now"           # Сейчас → 1 неделя
    NEAR_FUTURE = "soon"        # 1 неделя → 1 месяц  
    STRATEGIC_FUTURE = "later"  # 1 месяц → 1 год
    VISIONARY_FUTURE = "beyond" # 1+ год

@dataclass
class FutureProgression:
    """Прогрессивное улучшение во времени"""
    current_state: Dict[str, Any]
    future_states: Dict[FutureTense, Dict[str, Any]] = field(default_factory=dict)
    progression_path: List[Dict] = field(default_factory=list)
    success_probability: float = 0.0
    expected_impact: float = 0.0
    
    def will_achieve(self, metric: str, target_value: float, timeframe: FutureTense) -> bool:
        """Определит, будет ли достигнута цель в указанный срок"""
        current = self.current_state.get(metric, 0)
        future = self.future_states.get(timeframe, {}).get(metric, current)
        return future >= target_value

